<Experiments xmlns="http://modelica.org/HSExperiments1/HSExperiments" name="Tank area influence" description="Compare the same closed-loop reference step with two tank cross-sectional areas."><TransientExperiment name="Area_0p01_m2" description="Baseline area; same PI controller and reference profile." startTime="0.0" stopTime="120.0" stepSize="0.1"><Parameters source="params/tank_area_0p01.ssv" type="application/x-ssp-parameter-set" /><Stimuli type="text/csv" source="stimuli/level_step_0p40_to_0p43.csv" /></TransientExperiment><TransientExperiment name="Area_0p02_m2" description="Double the tank area; same PI controller and reference profile." startTime="0.0" stopTime="120.0" stepSize="0.1"><Parameters source="params/tank_area_0p02.ssv" type="application/x-ssp-parameter-set" /><Stimuli type="text/csv" source="stimuli/level_step_0p40_to_0p43.csv" /></TransientExperiment></Experiments>