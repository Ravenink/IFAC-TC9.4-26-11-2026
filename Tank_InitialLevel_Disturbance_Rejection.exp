<Experiments xmlns="http://modelica.org/HSExperiments1/HSExperiments" name="Tank initial-level perturbation recovery" description="Compare nominal operation with recovery from an initial level deviation under PI control."><TransientExperiment name="Nominal_initial_level" description="Initial level equals the fixed 0.40 m reference." startTime="0.0" stopTime="120.0" stepSize="0.1"><Parameters source="params/tank_h0_0p40.ssv" type="application/x-ssp-parameter-set" /><Stimuli type="text/csv" source="stimuli/constant_level_0p40.csv" /></TransientExperiment><TransientExperiment name="Initial_level_perturbation" description="Initial level is 0.35 m while the reference remains at 0.40 m." startTime="0.0" stopTime="120.0" stepSize="0.1"><Parameters source="params/tank_h0_0p35.ssv" type="application/x-ssp-parameter-set" /><Stimuli type="text/csv" source="stimuli/constant_level_0p40.csv" /></TransientExperiment></Experiments>